DATABASE_URL="postgresql://acrossflare:acrossflare@localhost:5434/acrossflare"
AUTH_SECRET="replace-with-a-long-random-string"

# 전자상거래 필수표기 (footer + /terms + /privacy). LEGAL_PHONE can be swapped later.
LEGAL_SERVICE_NAME="AcrossFlare"
LEGAL_ENTITY_NAME="어크로스툴(ACROSSTOOL)"
LEGAL_CEO="신일"
LEGAL_ADDRESS="강원특별자치도 양양군 서면 쌍솔배기길31-1"
LEGAL_PHONE="070-8065-1258"
LEGAL_EMAIL="acrosstool@gmail.com"
LEGAL_BUSINESS_NO="163-13-03007"
LEGAL_VAS_NO="제 2-04-26-0006 호"
# 통신판매업 신고번호. Empty falls back to the registered default in src/lib/legal/merchant.ts.
LEGAL_MAIL_ORDER_NO="제 2026-강원양양-0089 호"
LEGAL_HOSTING_PROVIDER="Cloudflare"

# Control-plane owner. Matching accounts are promoted to OWNER on login/signup.
# Do not put the owner password in git.
ADMIN_OWNER_EMAIL="acrosstool@gmail.com"

# simulate: checkout completes via signed local webhook. live: wait for PortOne/Stripe/Paymentwall.
PAYMENT_MODE="simulate"
PAYMENT_WEBHOOK_SECRET=""
PORTONE_WEBHOOK_SECRET=""
PORTONE_STORE_ID=""
PORTONE_CHANNEL_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
PAYMENTWALL_SECRET=""
PAYMENTWALL_PROJECT_KEY=""
PAYMENT_ALIPAY_PROVIDER="stripe"

# simulate: write 3x-ui / Vaultwarden / Syncthing credentials to DB without calling remote panels.
# live: POST 3x-ui /panel/api/inbounds/addClient, Vaultwarden admin invite, Syncthing folder API.
# Production: PROVISION_MODE=live (simulate disables Cron, Failover, and live 3x-ui provisioning).
PROVISION_MODE="simulate"
# Production: APP_URL=https://acrossflare.com (subscription URLs and Karing deep links).
APP_URL="http://localhost:3000"
BACKUP_DASHBOARD_URL="https://acrossflare.com/dashboard"
VAULTWARDEN_URL="https://vault.acrossflare.com"
# Compose origin uses this for admin invite. Leave empty locally; origin compose overrides to http://vaultwarden:80.
VAULTWARDEN_INTERNAL_URL=""
VAULTWARDEN_ADMIN_TOKEN=""
VAULTWARDEN_SIGNUPS_ALLOWED="false"
SYNCTHING_URL="https://sync.acrossflare.com"
SYNCTHING_INTERNAL_URL=""
SYNCTHING_API_KEY=""
XUI_API_TOKEN=""
XUI_TLS_INSECURE="0"
# Stable WireGuard server public key used as [Peer] PublicKey. Required when PROVISION_MODE=live (Marketing).
WG_SERVER_PUBLIC_KEY=""
ROTATE_COOLDOWN_MS="15000"
MARKETING_HTTP_PORT="8080"
MARKETING_SOCKS_PORT="1080"
MARKETING_WG_PORT="51820"

# FastAPI traffic sync cron. Default enabled (1). Set 0 to disable.
# Also disabled automatically when PROVISION_MODE=simulate or DATABASE_URL is empty.
# docker-compose defaults: TRAFFIC_SYNC_ENABLED=1, TRAFFIC_SYNC_INTERVAL=300 (5 min).
TRAFFIC_SYNC_ENABLED="1"
TRAFFIC_SYNC_INTERVAL="300"

# Origin VPS (`npm run origin:up`). Local `db:up` ignores these.
POSTGRES_USER="acrossflare"
POSTGRES_PASSWORD="acrossflare"
POSTGRES_DB="acrossflare"
# Production: COMPOSE_PROFILES=origin
COMPOSE_PROFILES=""
