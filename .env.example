DATABASE_URL="postgresql://acrossflare:acrossflare@localhost:5434/acrossflare"
AUTH_SECRET="replace-with-a-long-random-string"

# simulate: checkout completes via signed local webhook. live: wait for PortOne/Stripe/Paymentwall.
PAYMENT_MODE="simulate"
PAYMENT_WEBHOOK_SECRET=""
PORTONE_WEBHOOK_SECRET=""
PORTONE_STORE_ID=""
PORTONE_CHANNEL_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
PAYMENTWALL_SECRET=""
PAYMENTWALL_PROJECT_KEY=""
PAYMENT_ALIPAY_PROVIDER="stripe"

# simulate: write 3x-ui/Nextcloud credentials to DB without calling remote panels.
# live: POST 3x-ui /panel/api/inbounds/addClient and Nextcloud OCS (OCS-APIRequest).
PROVISION_MODE="simulate"
APP_URL="http://localhost:3000"
NEXTCLOUD_URL="https://files.acrossflare.com"
# Compose origin uses this for OCS. Leave empty locally; origin compose overrides to http://nextcloud:80.
NEXTCLOUD_INTERNAL_URL=""
NEXTCLOUD_ADMIN_USER="admin"
NEXTCLOUD_ADMIN_PASSWORD=""
XUI_API_TOKEN=""
XUI_TLS_INSECURE="0"
# Stable WireGuard server public key used as [Peer] PublicKey. Required when PROVISION_MODE=live.
WG_SERVER_PUBLIC_KEY=""
ROTATE_COOLDOWN_MS="15000"
MARKETING_HTTP_PORT="8080"
MARKETING_SOCKS_PORT="1080"
MARKETING_WG_PORT="51820"

# Origin VPS (`npm run origin:up`). Local `db:up` ignores these.
POSTGRES_USER="acrossflare"
POSTGRES_PASSWORD="acrossflare"
POSTGRES_DB="acrossflare"
NEXTCLOUD_DB_PASSWORD="change-me-nextcloud-db"
NEXTCLOUD_DB_ROOT_PASSWORD="change-me-nextcloud-root"
# on = require Cloudflare client certs (Full Strict + Authenticated Origin Pulls).
# off = local origin tests with infra/scripts/gen-dev-origin-certs.sh
ORIGIN_PULLS="on"
