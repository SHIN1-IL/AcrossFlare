generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  OWNER
  STAFF
}

enum Product {
  GLOBAL
  MARKETING
  WORKSPACE
}

enum SubscriptionStatus {
  ACTIVE
  UNPAID
  PROVISIONING
  FAILED
}

enum PaymentMethod {
  CARD
  ALIPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentProvider {
  PORTONE
  STRIPE
  PAYMENTWALL
}

enum PromoCodeStatus {
  UNUSED
  REDEEMED
}

enum NodeRole {
  BANDWAGON
  RACKNERD
}

enum NodeHealth {
  ONLINE
  DEGRADED
  OFFLINE
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)
  staffPermissions  String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions      Session[]
  subscriptions Subscription[]
  payments      Payment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Plan {
  id        String   @id
  product   Product
  name      String
  priceKrw  Int
  priceUsd  Int
  priceCny  Int
  priceJpy  Int
  trafficGb Int?
  backupGb  Int?
  nodeCodes String[]
  featured  Boolean  @default(false)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  promoCodes    PromoCode[]

  @@index([product])
}

model Node {
  id        String     @id @default(cuid())
  product   Product
  name      String
  ddns      String
  role      NodeRole
  status    NodeHealth @default(ONLINE)
  host      String
  port      Int
  username  String
  password  String
  inboundId Int?
  vlessPort            Int     @default(443)
  realityPublicKey     String?
  realityShortId       String?
  realityServerName    String?
  realityFingerprint   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  subscriptions Subscription[]

  trafficSnapshots TrafficSnapshot[]

  @@index([product])
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  product         Product
  status          SubscriptionStatus @default(PROVISIONING)
  expiresAt       DateTime
  memo            String             @default("")
  provisionStep   String             @default("queued")
  provisionError  String             @default("")
  trafficUsedGb   Float              @default(0)
  backupUsedGb    Float              @default(0)
  failover        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  nodes        Node[]
  credentials  Credential?
  rotateEvents RotateEvent[]
  payments     Payment[]
  trafficSnapshots TrafficSnapshot[]

  @@index([userId, product])
  @@index([status])
}

model Credential {
  id             String       @id @default(cuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  uuid                 String?
  deepLink             String?
  yamlToken            String? @unique
  yamlBody             String?
  vaultUrl           String?
  vaultUser          String?
  syncthingUrl       String?
  syncthingFolderId  String?
  xuiEmail             String?

  exitIp            String?
  region            String?
  httpUser          String?
  httpPass          String?
  httpPort          Int?
  socksPort         Int?
  wgPrivateKey      String?
  wgPublicKey       String?
  wgAddress         String?
  wgEndpointPort    Int?
  lastRotateAt      DateTime?
  rotateLockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RotateEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromIp         String
  toIp           String
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

model Payment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId         String
  plan           Plan             @relation(fields: [planId], references: [id])
  product        Product
  locale         String
  provider       PaymentProvider
  method         PaymentMethod
  status         PaymentStatus    @default(PENDING)
  amount         Int
  currency       String
  externalId     String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  webhookEvents WebhookEvent[]
  promoCode     PromoCode?

  @@index([userId])
  @@index([status])
}

model PromoCode {
  id         String          @id @default(cuid())
  code       String          @unique
  planId     String
  plan       Plan            @relation(fields: [planId], references: [id])
  note       String          @default("")
  status     PromoCodeStatus @default(UNUSED)
  paymentId  String?         @unique
  payment    Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  redeemedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([planId])
  @@index([status])
}

model WebhookEvent {
  id        String           @id
  provider  PaymentProvider
  paymentId String?
  payment   Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([paymentId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

model TrafficSnapshot {
  id             String   @id @default(cuid())
  subscriptionId String
  nodeId         String
  rawUp          BigInt   @default(0)
  rawDown        BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, nodeId])
  @@index([subscriptionId])
}

model TrafficSyncRun {
  id            String   @id @default(cuid())
  startedAt     DateTime
  completedAt   DateTime
  subscriptions Int
  updates       Int
  failovers     Int
  errors        Int
  durationMs    Int

  @@index([completedAt(sort: Desc)])
}
