generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  OWNER
  STAFF
}

enum Product {
  GLOBAL
  MARKETING
  WORKSPACE
}

enum SubscriptionStatus {
  ACTIVE
  UNPAID
  PROVISIONING
  FAILED
}

enum PaymentMethod {
  CARD
  ALIPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentProvider {
  PORTONE
  STRIPE
  PAYMENTWALL
}

enum PromoCodeStatus {
  UNUSED
  REDEEMED
}

enum NodeRole {
  PRIMARY
  FAILOVER
}

enum NodeHealth {
  ONLINE
  DEGRADED
  OFFLINE
}

enum InstanceGroupStatus {
  READY
  OPENING
  DRAINING
}

enum BootstrapJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)
  staffPermissions  String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions      Session[]
  subscriptions Subscription[]
  payments      Payment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Plan {
  id        String   @id
  product   Product
  name      String
  priceKrw  Int
  priceUsd  Int
  priceCny  Int
  priceJpy  Int
  trafficGb Int?
  backupGb  Int?
  nodeCodes String[]
  /// Capacity pool for node assignment. Null = no VPN nodes (e.g. Workspace).
  poolId    String?
  pool      CapacityPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  featured  Boolean  @default(false)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  promoCodes    PromoCode[]

  @@index([product])
  @@index([poolId])
}

/// Logical capacity pool (e.g. standard=1 selectable, hybrid=2). Provider-agnostic.
model CapacityPool {
  id            String   @id
  product       Product
  name          String
  /// How many PRIMARY nodes a subscriber may receive from a group.
  maxSelectable Int      @default(1)
  /// Default seat cap when creating a new instance group.
  seatsMaxDefault Int    @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans  Plan[]
  groups InstanceGroup[]

  @@index([product])
}

/// One concrete set of nodes that shares a seat counter.
model InstanceGroup {
  id        String              @id @default(cuid())
  poolId    String
  pool      CapacityPool        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  name      String
  status    InstanceGroupStatus @default(READY)
  seatsUsed Int                 @default(0)
  seatsMax  Int                 @default(10)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  nodes         InstanceGroupNode[]
  subscriptions Subscription[]     @relation("GroupSubscriptions")
  karingProbe   Subscription?       @relation("GroupKaringProbe")

  @@index([poolId, status])
}

model InstanceGroupNode {
  groupId   String
  group     InstanceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  nodeId    String
  node      Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  sortOrder Int           @default(0)

  @@id([groupId, nodeId])
  @@index([nodeId])
}

model Node {
  id        String     @id @default(cuid())
  product   Product
  name      String
  ddns      String
  role      NodeRole
  /// Vendor label only (bandwagon, racknerd, contabo, …). Not used for failover routing.
  provider  String     @default("")
  status    NodeHealth @default(ONLINE)
  host      String
  port      Int
  username  String
  password  String
  inboundId Int?
  vlessPort            Int     @default(443)
  realityPublicKey     String?
  realityShortId       String?
  realityServerName    String?
  realityFingerprint   String?
  /// Monthly VPS purchase cost in KRW. The owner margin card sums these.
  monthlyCostKrw       Int     @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  subscriptions Subscription[]
  probeSubscription Subscription? @relation("NodeKaringProbe")

  trafficSnapshots TrafficSnapshot[]
  groupMemberships InstanceGroupNode[]

  @@index([product])
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  product         Product
  status          SubscriptionStatus @default(PROVISIONING)
  expiresAt       DateTime
  memo            String             @default("")
  provisionStep   String             @default("queued")
  provisionError  String             @default("")
  trafficUsedGb   Float              @default(0)
  backupUsedGb    Float              @default(0)
  failover        Boolean            @default(false)
  instanceGroupId String?
  instanceGroup   InstanceGroup?     @relation("GroupSubscriptions", fields: [instanceGroupId], references: [id], onDelete: SetNull)
  /// Admin Karing check for one node. Null on every customer subscription.
  probeNodeId     String?            @unique
  probeNode       Node?              @relation("NodeKaringProbe", fields: [probeNodeId], references: [id], onDelete: Cascade)
  /// Admin Karing check for one node bundle. Null on every customer subscription.
  probeGroupId    String?            @unique
  probeGroup      InstanceGroup?     @relation("GroupKaringProbe", fields: [probeGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  nodes        Node[]
  credentials  Credential?
  rotateEvents RotateEvent[]
  payments     Payment[]
  trafficSnapshots TrafficSnapshot[]

  @@index([userId, product])
  @@index([status])
  @@index([instanceGroupId])
}

model Credential {
  id             String       @id @default(cuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  uuid                 String?
  deepLink             String?
  yamlToken            String? @unique
  yamlBody             String?
  vaultUrl           String?
  vaultUser          String?
  syncthingUrl       String?
  syncthingFolderId  String?
  xuiEmail             String?

  exitIp            String?
  region            String?
  httpUser          String?
  httpPass          String?
  httpPort          Int?
  socksPort         Int?
  wgPrivateKey      String?
  wgPublicKey       String?
  wgAddress         String?
  wgEndpointPort    Int?
  lastRotateAt      DateTime?
  rotateLockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RotateEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromIp         String
  toIp           String
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

model Payment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId         String
  plan           Plan             @relation(fields: [planId], references: [id])
  product        Product
  locale         String
  provider       PaymentProvider
  method         PaymentMethod
  status         PaymentStatus    @default(PENDING)
  amount         Int
  currency       String
  externalId     String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  webhookEvents WebhookEvent[]
  promoCode     PromoCode?

  @@index([userId])
  @@index([status])
}

model PromoCode {
  id         String          @id @default(cuid())
  code       String          @unique
  planId     String
  plan       Plan            @relation(fields: [planId], references: [id])
  note       String          @default("")
  status     PromoCodeStatus @default(UNUSED)
  paymentId  String?         @unique
  payment    Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  redeemedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([planId])
  @@index([status])
}

model WebhookEvent {
  id        String           @id
  provider  PaymentProvider
  paymentId String?
  payment   Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([paymentId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

/// One-shot node bootstrap (purchase → IP/SSH → panel + REALITY + DDNS + DB).
/// SSH secrets are never persisted; only passed in-memory for the run.
model NodeBootstrapJob {
  id          String             @id @default(cuid())
  status      BootstrapJobStatus @default(QUEUED)
  product     Product
  role        NodeRole           @default(PRIMARY)
  provider    String             @default("")
  poolId      String?
  groupId     String?
  name        String
  ddnsHost    String
  sshHost     String
  sshPort     Int                @default(22)
  sshUser     String             @default("root")
  panelPort   Int                @default(2053)
  vlessPort   Int                @default(443)
  realityDest String             @default("www.microsoft.com")
  nodeId      String?
  log         String             @default("")
  error       String             @default("")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
}

model TrafficSnapshot {
  id             String   @id @default(cuid())
  subscriptionId String
  nodeId         String
  rawUp          BigInt   @default(0)
  rawDown        BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, nodeId])
  @@index([subscriptionId])
}

/// Cash sales, friends, and other revenue that never hits Payment.
model MarginAdjustment {
  id        String   @id @default(cuid())
  label     String
  amountKrw Int
  note      String   @default("")
  /// When true, counted every month from `month` onward.
  recurring Boolean  @default(false)
  /// YYYY-MM in Asia/Seoul. One-time month, or the first month of a recurring entry.
  month     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

model TrafficSyncRun {
  id            String   @id @default(cuid())
  startedAt     DateTime
  completedAt   DateTime
  subscriptions Int
  updates       Int
  failovers     Int
  errors        Int
  durationMs    Int

  @@index([completedAt(sort: Desc)])
}
